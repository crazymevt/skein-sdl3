(ffi/defcenum sdl-system-cursor i32 (:default 0) (:text 1) (:wait 2) (:crosshair 3) (:progress 4)
  (:nwse-resize 5) (:nesw-resize 6) (:ew-resize 7) (:ns-resize 8) (:move 9) (:not-allowed 10)
  (:pointer 11) (:nw-resize 12) (:n-resize 13) (:ne-resize 14) (:e-resize 15) (:se-resize 16)
  (:s-resize 17) (:sw-resize 18) (:w-resize 19) (:count 20))
(def system-cursor-default 0)
(def system-cursor-text 1)
(def system-cursor-wait 2)
(def system-cursor-crosshair 3)
(def system-cursor-progress 4)
(def system-cursor-nwse-resize 5)
(def system-cursor-nesw-resize 6)
(def system-cursor-ew-resize 7)
(def system-cursor-ns-resize 8)
(def system-cursor-move 9)
(def system-cursor-not-allowed 10)
(def system-cursor-pointer 11)
(def system-cursor-nw-resize 12)
(def system-cursor-n-resize 13)
(def system-cursor-ne-resize 14)
(def system-cursor-e-resize 15)
(def system-cursor-se-resize 16)
(def system-cursor-s-resize 17)
(def system-cursor-sw-resize 18)
(def system-cursor-w-resize 19)
(def system-cursor-count 20)

(ffi/defcenum sdl-system-theme i32 (:unknown 0) (:light 1) (:dark 2))
(def system-theme-unknown 0)
(def system-theme-light 1)
(def system-theme-dark 2)

(ffi/defcenum sdl-text-input-type i32 (:text 0) (:text-name 1) (:text-email 2) (:text-username 3)
  (:text-password-hidden 4) (:text-password-visible 5) (:number 6) (:number-password-hidden 7)
  (:number-password-visible 8))
(def textinput-type-text 0)
(def textinput-type-text-name 1)
(def textinput-type-text-email 2)
(def textinput-type-text-username 3)
(def textinput-type-text-password-hidden 4)
(def textinput-type-text-password-visible 5)
(def textinput-type-number 6)
(def textinput-type-number-password-hidden 7)
(def textinput-type-number-password-visible 8)

(ffi/defcenum sdl-texture-access i32 (:static 0) (:streaming 1) (:target 2))
(def textureaccess-static 0)
(def textureaccess-streaming 1)
(def textureaccess-target 2)

(ffi/defcenum sdl-texture-address-mode i32 (:invalid -1) (:auto 0) (:clamp 1) (:wrap 2))
(def texture-address-invalid -1)
(def texture-address-auto 0)
(def texture-address-clamp 1)
(def texture-address-wrap 2)

(ffi/defcenum sdl-transfer-characteristics i32 (:unknown 0) (:bt709 1) (:unspecified 2) (:gamma22 4)
  (:gamma28 5) (:bt601 6) (:smpte240 7) (:linear 8) (:log100 9) (:log100-sqrt10 10) (:iec61966 11)
  (:bt1361 12) (:srgb 13) (:bt2020-10-bit 14) (:bt2020-12-bit 15) (:pq 16) (:smpte428 17) (:hlg 18)
  (:custom 31))
(def transfer-characteristics-unknown 0)
(def transfer-characteristics-bt709 1)
(def transfer-characteristics-unspecified 2)
(def transfer-characteristics-gamma22 4)
(def transfer-characteristics-gamma28 5)
(def transfer-characteristics-bt601 6)
(def transfer-characteristics-smpte240 7)
(def transfer-characteristics-linear 8)
(def transfer-characteristics-log100 9)
(def transfer-characteristics-log100-sqrt10 10)
(def transfer-characteristics-iec61966 11)
(def transfer-characteristics-bt1361 12)
(def transfer-characteristics-srgb 13)
(def transfer-characteristics-bt2020-10-bit 14)
(def transfer-characteristics-bt2020-12-bit 15)
(def transfer-characteristics-pq 16)
(def transfer-characteristics-smpte428 17)
(def transfer-characteristics-hlg 18)
(def transfer-characteristics-custom 31)

;;; Structs and unions

(ffi/defcstruct sdl-audio-device-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32) (recording bool) (padding1 u8) (padding2 u8) (padding3 u8))
(ffi/defcstruct sdl-camera-device-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32))
(ffi/defcstruct sdl-clipboard-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (owner bool) (num-mime-types i32) (mime-types (ptr ptr)))
(ffi/defcstruct sdl-color (r u8) (g u8) (b u8) (a u8))
(ffi/defcstruct sdl-common-event (type u32) (reserved u32) (timestamp u64))
(ffi/defcstruct sdl-cursor-frame-info (surface (ptr sdl-surface)) (duration u32))
(ffi/defcstruct sdl-display-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (display-id u32) (data1 i32) (data2 i32))
(ffi/defcstruct sdl-display-mode (display-id u32) (format sdl-pixel-format) (w i32) (h i32)
  (pixel-density f32) (refresh-rate f32) (refresh-rate-numerator i32) (refresh-rate-denominator i32)
  (internal (ptr sdl-display-mode-data)))
(ffi/defcstruct sdl-drop-event (type sdl-event-type) (reserved u32) (timestamp u64) (window-id u32)
  (x f32) (y f32) (source (ptr i8)) (data (ptr i8)))
(ffi/defcstruct sdl-window-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (data1 i32) (data2 i32))
(ffi/defcstruct sdl-keyboard-device-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32))
(ffi/defcstruct sdl-keyboard-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (which u32) (scancode sdl-scancode) (key u32) (mod u16) (raw u16) (down bool)
  (repeat bool))
(ffi/defcstruct sdl-text-editing-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (text (ptr i8)) (start i32) (length i32))
(ffi/defcstruct sdl-text-editing-candidates-event (type sdl-event-type) (reserved u32)
  (timestamp u64) (window-id u32) (candidates (ptr ptr)) (num-candidates i32)
  (selected-candidate i32) (horizontal bool) (padding1 u8) (padding2 u8) (padding3 u8))
(ffi/defcstruct sdl-text-input-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (text (ptr i8)))
(ffi/defcstruct sdl-mouse-device-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32))
(ffi/defcstruct sdl-mouse-motion-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (which u32) (state u32) (x f32) (y f32) (xrel f32) (yrel f32))
(ffi/defcstruct sdl-mouse-button-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (which u32) (button u8) (down bool) (clicks u8) (padding u8) (x f32) (y f32))
(ffi/defcstruct sdl-mouse-wheel-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (which u32) (x f32) (y f32) (direction sdl-mouse-wheel-direction) (mouse-x f32)
  (mouse-y f32) (integer-x i32) (integer-y i32))
(ffi/defcstruct sdl-joy-device-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32))
(ffi/defcstruct sdl-joy-axis-event (type sdl-event-type) (reserved u32) (timestamp u64) (which u32)
  (axis u8) (padding1 u8) (padding2 u8) (padding3 u8) (value i16) (padding4 u16))
(ffi/defcstruct sdl-joy-ball-event (type sdl-event-type) (reserved u32) (timestamp u64) (which u32)
  (ball u8) (padding1 u8) (padding2 u8) (padding3 u8) (xrel i16) (yrel i16))
(ffi/defcstruct sdl-joy-hat-event (type sdl-event-type) (reserved u32) (timestamp u64) (which u32)
  (hat u8) (value u8) (padding1 u8) (padding2 u8))
(ffi/defcstruct sdl-joy-button-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32) (button u8) (down bool) (padding1 u8) (padding2 u8))
(ffi/defcstruct sdl-joy-battery-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32) (state i32) (percent i32))
(ffi/defcstruct sdl-gamepad-device-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32))
(ffi/defcstruct sdl-gamepad-axis-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32) (axis u8) (padding1 u8) (padding2 u8) (padding3 u8) (value i16) (padding4 u16))
(ffi/defcstruct sdl-gamepad-button-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32) (button u8) (down bool) (padding1 u8) (padding2 u8))
(ffi/defcstruct sdl-gamepad-touchpad-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32) (touchpad i32) (finger i32) (x f32) (y f32) (pressure f32))
(ffi/defcstruct sdl-gamepad-sensor-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (which u32) (sensor i32) (data (array f32 3)) (sensor-timestamp u64))
(ffi/defcstruct sdl-sensor-event (type sdl-event-type) (reserved u32) (timestamp u64) (which u32)
  (data (array f32 6)) (sensor-timestamp u64))
(ffi/defcstruct sdl-quit-event (type sdl-event-type) (reserved u32) (timestamp u64))
(ffi/defcstruct sdl-user-event (type u32) (reserved u32) (timestamp u64) (window-id u32) (code i32)
  (data1 ptr) (data2 ptr))
(ffi/defcstruct sdl-touch-finger-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (touch-id u64) (finger-id u64) (x f32) (y f32) (dx f32) (dy f32) (pressure f32) (window-id u32))
(ffi/defcstruct sdl-pinch-finger-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (scale f32) (window-id u32))
(ffi/defcstruct sdl-pen-proximity-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (which u32) (pen-state u32) (device-type i32))
(ffi/defcstruct sdl-pen-touch-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (which u32) (pen-state u32) (x f32) (y f32) (eraser bool) (down bool)
  (device-type i32))
(ffi/defcstruct sdl-pen-motion-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (which u32) (pen-state u32) (x f32) (y f32) (device-type i32))
(ffi/defcstruct sdl-pen-button-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (which u32) (pen-state u32) (x f32) (y f32) (button u8) (down bool)
  (device-type i32))
(ffi/defcstruct sdl-pen-axis-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32) (which u32) (pen-state u32) (x f32) (y f32) (axis i32) (value f32)
  (device-type i32))
(ffi/defcstruct sdl-render-event (type sdl-event-type) (reserved u32) (timestamp u64)
  (window-id u32))
(ffi/defcunion sdl-event (type u32) (common sdl-common-event) (display sdl-display-event)
  (window sdl-window-event) (kdevice sdl-keyboard-device-event) (key sdl-keyboard-event)
  (edit sdl-text-editing-event) (edit-candidates sdl-text-editing-candidates-event)
  (text sdl-text-input-event) (mdevice sdl-mouse-device-event) (motion sdl-mouse-motion-event)
  (button sdl-mouse-button-event) (wheel sdl-mouse-wheel-event) (jdevice sdl-joy-device-event)
  (jaxis sdl-joy-axis-event) (jball sdl-joy-ball-event) (jhat sdl-joy-hat-event)
  (jbutton sdl-joy-button-event) (jbattery sdl-joy-battery-event) (gdevice sdl-gamepad-device-event)
  (gaxis sdl-gamepad-axis-event) (gbutton sdl-gamepad-button-event)
  (gtouchpad sdl-gamepad-touchpad-event) (gsensor sdl-gamepad-sensor-event)
  (adevice sdl-audio-device-event) (cdevice sdl-camera-device-event) (sensor sdl-sensor-event)
  (quit sdl-quit-event) (user sdl-user-event) (tfinger sdl-touch-finger-event)
  (pinch sdl-pinch-finger-event) (pproximity sdl-pen-proximity-event) (ptouch sdl-pen-touch-event)
  (pmotion sdl-pen-motion-event) (pbutton sdl-pen-button-event) (paxis sdl-pen-axis-event)
  (render sdl-render-event) (drop sdl-drop-event) (clipboard sdl-clipboard-event)
  (padding (array u8 128)))
(ffi/defcstruct sdl-fcolor (r f32) (g f32) (b f32) (a f32))
(ffi/defcstruct sdl-fpoint (x f32) (y f32))
(ffi/defcstruct sdl-frect (x f32) (y f32) (w f32) (h f32))
(ffi/defcstruct sdl-gpu-render-state-create-info (fragment-shader (ptr sdl-gpu-shader))
  (num-sampler-bindings i32) (sampler-bindings (ptr sdl-gpu-texture-sampler-binding))
  (num-storage-textures i32) (storage-textures (ptr ptr)) (num-storage-buffers i32)
  (storage-buffers (ptr ptr)) (props u32))
(ffi/defcstruct sdl-palette (ncolors i32) (colors (ptr sdl-color)) (version u32) (refcount i32))
(ffi/defcstruct sdl-pixel-format-details (format sdl-pixel-format) (bits-per-pixel u8)
  (bytes-per-pixel u8) (padding (array u8 2)) (rmask u32) (gmask u32) (bmask u32) (amask u32)
  (rbits u8) (gbits u8) (bbits u8) (abits u8) (rshift u8) (gshift u8) (bshift u8) (ashift u8))
(ffi/defcstruct sdl-point (x i32) (y i32))
(ffi/defcstruct sdl-rect (x i32) (y i32) (w i32) (h i32))
(ffi/defcstruct sdl-surface (flags u32) (format sdl-pixel-format) (w i32) (h i32) (pitch i32)
  (pixels ptr) (refcount i32) (reserved ptr))
(ffi/defcstruct sdl-texture (format sdl-pixel-format) (w i32) (h i32) (refcount i32))
(ffi/defcstruct sdl-vertex (position sdl-fpoint) (color sdl-fcolor) (tex-coord sdl-fpoint))

;;; Functions

(ffi/defcfun add-event-watch "SDL_AddEventWatch" bool [filter ptr, userdata ptr])
(ffi/defcfun add-hint-callback "SDL_AddHintCallback" bool
  [name c-string, callback ptr, userdata ptr])
(ffi/defcfun add-surface-alternate-image "SDL_AddSurfaceAlternateImage" bool
  [surface (ptr sdl-surface), image (ptr sdl-surface)])
(ffi/defcfun add-timer "SDL_AddTimer" u32 [interval u32, callback ptr, userdata ptr])
