;;; Enums

(ffi/defcenum sdl-app-result i32 (:continue 0) (:success 1) (:failure 2))
(def app-continue 0)
(def app-success 1)
(def app-failure 2)

(ffi/defcenum sdl-array-order i32 (:none 0) (:rgb 1) (:rgba 2) (:argb 3) (:bgr 4) (:bgra 5)
  (:abgr 6))
(def arrayorder-none 0)
(def arrayorder-rgb 1)
(def arrayorder-rgba 2)
(def arrayorder-argb 3)
(def arrayorder-bgr 4)
(def arrayorder-bgra 5)
(def arrayorder-abgr 6)

(ffi/defcenum sdl-bitmap-order i32 (:none 0) (:bitmaporder-4321 1) (:bitmaporder-1234 2))
(def bitmaporder-none 0)
(def bitmaporder-4321 1)
(def bitmaporder-1234 2)

(ffi/defcenum sdl-blend-factor i32 (:zero 1) (:one 2) (:src-color 3) (:one-minus-src-color 4)
  (:src-alpha 5) (:one-minus-src-alpha 6) (:dst-color 7) (:one-minus-dst-color 8) (:dst-alpha 9)
  (:one-minus-dst-alpha 10))
(def blendfactor-zero 1)
(def blendfactor-one 2)
(def blendfactor-src-color 3)
(def blendfactor-one-minus-src-color 4)
(def blendfactor-src-alpha 5)
(def blendfactor-one-minus-src-alpha 6)
(def blendfactor-dst-color 7)
(def blendfactor-one-minus-dst-color 8)
(def blendfactor-dst-alpha 9)
(def blendfactor-one-minus-dst-alpha 10)

(ffi/defcenum sdl-blend-operation i32 (:add 1) (:subtract 2) (:rev-subtract 3) (:minimum 4)
  (:maximum 5))
(def blendoperation-add 1)
(def blendoperation-subtract 2)
(def blendoperation-rev-subtract 3)
(def blendoperation-minimum 4)
(def blendoperation-maximum 5)

(ffi/defcenum sdl-capitalization i32 (:none 0) (:sentences 1) (:words 2) (:letters 3))
(def capitalize-none 0)
(def capitalize-sentences 1)
(def capitalize-words 2)
(def capitalize-letters 3)

(ffi/defcenum sdl-chroma-location i32 (:none 0) (:left 1) (:center 2) (:topleft 3))
(def chroma-location-none 0)
(def chroma-location-left 1)
(def chroma-location-center 2)
(def chroma-location-topleft 3)

(ffi/defcenum sdl-color-primaries i32 (:unknown 0) (:bt709 1) (:unspecified 2) (:bt470-m 4)
  (:bt470-bg 5) (:bt601 6) (:smpte240 7) (:generic-film 8) (:bt2020 9) (:xyz 10) (:smpte431 11)
  (:smpte432 12) (:ebu3213 22) (:custom 31))
(def color-primaries-unknown 0)
(def color-primaries-bt709 1)
(def color-primaries-unspecified 2)
(def color-primaries-bt470-m 4)
(def color-primaries-bt470-bg 5)
(def color-primaries-bt601 6)
(def color-primaries-smpte240 7)
(def color-primaries-generic-film 8)
(def color-primaries-bt2020 9)
(def color-primaries-xyz 10)
(def color-primaries-smpte431 11)
(def color-primaries-smpte432 12)
(def color-primaries-ebu3213 22)
(def color-primaries-custom 31)

(ffi/defcenum sdl-color-range i32 (:unknown 0) (:limited 1) (:full 2))
(def color-range-unknown 0)
(def color-range-limited 1)
(def color-range-full 2)

(ffi/defcenum sdl-color-type i32 (:unknown 0) (:rgb 1) (:ycbcr 2))
(def color-type-unknown 0)
(def color-type-rgb 1)
(def color-type-ycbcr 2)

(ffi/defcenum sdl-colorspace i32 (:unknown 0) (:srgb 1) (:srgb-linear 2) (:hdr10 3) (:jpeg 4)
  (:bt601-limited 5) (:bt601-full 6) (:bt709-limited 7) (:bt709-full 8) (:bt2020-limited 9)
  (:bt2020-full 10) (:rgb-default 301991328) (:yuv-default 554703046))
(def colorspace-unknown 0)
(def colorspace-srgb 1)
(def colorspace-srgb-linear 2)
(def colorspace-hdr10 3)
(def colorspace-jpeg 4)
(def colorspace-bt601-limited 5)
(def colorspace-bt601-full 6)
(def colorspace-bt709-limited 7)
(def colorspace-bt709-full 8)
(def colorspace-bt2020-limited 9)
(def colorspace-bt2020-full 10)
(def colorspace-rgb-default 301991328)
(def colorspace-yuv-default 554703046)

(ffi/defcenum sdl-display-orientation i32 (:unknown 0) (:landscape 1) (:landscape-flipped 2)
  (:portrait 3) (:portrait-flipped 4))
(def orientation-unknown 0)
(def orientation-landscape 1)
(def orientation-landscape-flipped 2)
(def orientation-portrait 3)
(def orientation-portrait-flipped 4)

(ffi/defcenum sdl-event-action i32 (:addevent 0) (:peekevent 1) (:getevent 2))
(def addevent 0)
(def peekevent 1)
(def getevent 2)

